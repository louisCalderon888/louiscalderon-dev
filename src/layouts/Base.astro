---
import "../styles/global.css";
import { waLink, PORTFOLIO_URL } from "../lib/site";

// Regression: ISSUE-001 — placeholder portfolio link site-wide (footer)
// Found by /qa on 2026-11-10. Render link only when PORTFOLIO_URL is real.
const PORTFOLIO_LIVE = PORTFOLIO_URL && !/poner/i.test(PORTFOLIO_URL);

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Ingeniería para cuentas de fondeo: sistemas automatizados backtesteados y calibrados a las reglas exactas de tu firma de trading. Instalado en tu VPS, con límites de riesgo pactados antes de pagar.",
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231f7a4d'/%3E%3Cpath d='M8 22 L14 15 L18 18 L24 10' stroke='%23faf7f2' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">Louis Calderón</a>
        <nav>
          <a href="/ninjatrader/" aria-current={Astro.url.pathname === '/ninjatrader/' ? 'page' : undefined}>Oferta</a>
          <a href="/ninjatrader/matriz/" aria-current={Astro.url.pathname.startsWith('/ninjatrader/matriz') ? 'page' : undefined}>Matriz de fondeos</a>
          <a href="/contacto/" aria-current={Astro.url.pathname === '/contacto/' ? 'page' : undefined}>Contacto</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Louis Calderón — Ingeniería para cuentas de fondeo.</span>
        <span>
          <a href={waLink} rel="noopener">WhatsApp</a>
          {PORTFOLIO_LIVE && (
            <>
              &nbsp;·&nbsp;
              <a href={PORTFOLIO_URL} rel="noopener">Portfolio general de desarrollo</a>
            </>
          )}
        </span>
      </div>
    </footer>
  </body>
</html>
